# Text is stored with LF in the repository, whatever the committing machine uses.
* text=auto

# Line endings that must not depend on the checkout's core.autocrlf.
# Shell scripts and the nftables ruleset are copied into Linux containers: a CRLF
# there breaks them ("bash\r: No such file or directory"). The Windows launcher is
# read by cmd.exe, whose label search is only reliable with CRLF.
*.sh    text eol=lf
*.nft   text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.docx  binary
*.xlsx  binary
*.pdf   binary
*.png   binary
*.jpg   binary
