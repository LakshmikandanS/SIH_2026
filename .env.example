# Citadel's settings, for reference. Nothing loads this file automatically: set what you
# need in the environment of the command that starts Citadel -- `set NAME=value` in a
# Windows Command Prompt before `citadel`, `export NAME=value` before scripts/*.sh.
# Every setting has a working default; the demonstration needs none of them.

# --- citadel.cmd / scripts/up.sh (Docker Compose, ops/compose/docker-compose.yml) -------
CITADEL_PORT=8000                        # the browser port, published on 127.0.0.1 only
CITADEL_DB_PASSWORD=citadel-local-only   # Postgres never leaves its internal network
CITADEL_REQUIRE_ENFORCEMENT=0            # 1: api/worker refuse to start if the egress
                                         #    ruleset cannot be applied (docs/adr/0006)
CITADEL_INFERENCE_ENDPOINT=http://host.docker.internal:11434   # Ollama, as the containers see it
CITADEL_ORG_NAME=Citadel demonstration plant                   # printed on deliverables

# --- scripts/run.sh (no containers; the developer path) ---------------------------------
# PG* come from scripts/dev-db.sh. The rest default to paths inside the repository.
# CITADEL_INFERENCE_ENDPOINT=http://127.0.0.1:11434
# CITADEL_KEYS_DIR=.dev/keys
# CITADEL_DATA_DIR=.citadel-data
# CITADEL_API_HOST=127.0.0.1
# CITADEL_API_PORT=8000
# CITADEL_FAKE_PORT=11435                # --fake-models: the scripted stand-in runtime

# --- the worker ---------------------------------------------------------------------------
# CITADEL_WORKERS=3                      # task threads
# CITADEL_MAX_STEPS=14                   # per-task step budget
# CITADEL_MAX_TASK_SECONDS=1500          # per-task wall-clock budget
# CITADEL_SEED_CORPUS=1                  # 1: add ops/demo/corpus once the approved models are
#                                        #    installed; now: add it at once, models or not

# --- key material (citadel_platform.keyring) ----------------------------------------------
# A keys directory created once (`python -m citadel_platform.keyring init`) holds the
# session key and the receipt keypair. Explicit variables win over the files, for an
# operator with a real secret store. The session and receipt keys are never the same key.
# CITADEL_KEYS_DIR=/keys
# CITADEL_SESSION_SIGNING_KEY=           # base64 Ed25519 private key
# CITADEL_RECEIPT_SIGNING_KEY=           # base64 Ed25519 private key (api and worker only)
# CITADEL_RECEIPT_PUBLIC_KEY=            # base64 Ed25519 public key (all the sandbox holds)

# --- profiles ---------------------------------------------------------------------------
#   demo-local -> RTX 5060, Ollama, one box. THE DEMONSTRATION. Sovereign.
#   hpc-eval   -> university HPC, vLLM. Benchmarking only. Never confidential material.
# CITADEL_PROFILE=demo-local
# CITADEL_HPC_ENDPOINT_FILE=             # hpc-eval: written by the sbatch script (ops/hpc/README.md)
