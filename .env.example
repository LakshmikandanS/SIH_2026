# Copy to .env. Never commit .env.

# Which registry files load. See registry/profiles.yaml.
#   demo-local  -> RTX 5060, Ollama, one box. THE DEMONSTRATION. Sovereign.
#   hpc-eval    -> university HPC, vLLM. Benchmarking only. Never confidential material.
CITADEL_PROFILE=demo-local

# --- Postgres (app side, for ops/compose's containerized Postgres) ---
# scripts/dev-db.sh's own disposable dev database (what scripts/run-api.sh and
# scripts/check.sh's Postgres-backed tests use) is unrelated and unconfigured by these --
# it prints its own PGHOST/PGPORT/PGUSER to export instead. See that script's own header.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=citadel
POSTGRES_USER=citadel
POSTGRES_PASSWORD=change-me-before-first-run

# --- Session token signing (citadel_platform.identity.keys) ---
# A per-process random secret is the fail-closed DEFAULT: leave this unset and login
# still works, but every session becomes unverifiable the moment the api process
# restarts (and unverifiable to any OTHER process right now). Set this to managed key
# material -- generate one with `python -m citadel_platform.identity genkey` -- for
# anything longer-lived than a single throwaway dev process. Deliberately its own
# variable, never shared with a future receipt-signing key: see citadel_contracts.
# identity's own module docstring for why the two must never use the same key.
CITADEL_SESSION_SIGNING_KEY=

# --- hpc-eval only ---
# SLURM allocates a different compute node per job, so the endpoint is written by
# the sbatch script rather than configured. See ops/hpc/README.md.
CITADEL_HPC_ENDPOINT_FILE=
